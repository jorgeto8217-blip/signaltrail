{
  "name": "signaltrail",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "deps:up": "docker compose up -d --wait",
    "deps:down": "docker compose down",
    "fixtures:validate": "pnpm --filter @signaltrail/contracts fixtures:validate"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
